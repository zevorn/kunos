/dts-v1/;

/ {
    #address-cells = <2>;
    #size-cells = <2>;
    model = "Canaan K230 CanMV";
    compatible = "canaan,k230-canmv", "canaan,k230";

    aliases {
        serial0 = &uart0;
    };

    chosen {
        bootargs = "";
        stdout-path = "serial0:115200";
    };

    ddr: memory@0 {
        device_type = "memory";
        reg = <0x0 0x0 0x0 0x80000000>;
    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;
        timebase-frequency = <27000000>;

        cpu@0 {
            device_type = "cpu";
            reg = <0>;
            status = "okay";
            compatible = "riscv";
            riscv,isa = "rv64imafdc";
            mmu-type = "riscv,sv39";
            cpu0_intc: interrupt-controller {
                #interrupt-cells = <1>;
                compatible = "riscv,cpu-intc";
                interrupt-controller;
            };
        };
    };

    soc {
        #address-cells = <2>;
        #size-cells = <2>;
        compatible = "simple-bus";
        ranges;

        clint0: clint@f04000000 {
            compatible = "riscv,clint0";
            interrupts-extended = <&cpu0_intc 3 &cpu0_intc 7>;
            reg = <0xf 0x04000000 0x0 0x04000000>;
            clint,has-no-64bit-mmio;
        };

        intc: interrupt-controller@f00000000 {
            #interrupt-cells = <1>;
            compatible = "riscv,plic0";
            interrupt-controller;
            interrupts-extended = <&cpu0_intc 0xffffffff &cpu0_intc 9>;
            reg = <0xf 0x00000000 0x0 0x04000000>;
            reg-names = "control";
            riscv,max-priority = <7>;
            riscv,ndev = <200>;
        };

        uart0: serial@91400000 {
            compatible = "snps,dw-apb-uart";
            reg = <0x0 0x91400000 0x0 0x1000>;
            interrupt-parent = <&intc>;
            interrupts = <16>;
            clock-frequency = <50000000>;
            reg-shift = <2>;
            reg-io-width = <4>;
            status = "okay";
        };
    };
};
